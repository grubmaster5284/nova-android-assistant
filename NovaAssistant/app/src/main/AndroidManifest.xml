<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet Permission (Required for Porcupine activation) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Microphone Permission (Runtime - Dangerous) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notification Permission (Required for Foreground Service on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Contact Permissions (Runtime - Dangerous) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Phone Call Permission (Runtime - Dangerous) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Declare telephony feature as optional for Chrome OS compatibility -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Wake Lock (for keeping service alive) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".NovaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaAssistant">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NovaAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wake Word Detection Service -->
        <service
            android:name=".data.service.WakeWordService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>