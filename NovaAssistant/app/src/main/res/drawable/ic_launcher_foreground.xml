<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Opaque background so no transparency shows through circular mask on home screen -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_icon_background" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <!-- Nova icon centered and scaled with padding -->
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <bitmap
            android:src="@drawable/nova_icon"
            android:gravity="fill" />
    </item>
</layer-list>
